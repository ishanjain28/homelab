          "expr": "count(sum by (host, container) (count_over_time({source=\"journald\", host=~\"$host\", container=~\"$container\", unit=~\"$unit\", unit=~\".+[.]service\", unit!~\"$noise\", priority=~\"$priority\"} |~ \"$search\" | $parser [$__range])))",
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
