                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "crit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "err"
            },
            "properties": [
              {
                "id": "color",
                "value": {
