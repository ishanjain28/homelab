{
  "uid": "homelab-logs",
  "title": "Homelab Logs",
  "description": "Journald logs from hosts and nspawn service containers, collected by Alloy and stored in Loki. Fields that Alloy attaches as structured metadata (Caddy access logs) are always filterable; switch Parser to JSON or logfmt to parse other services' lines at query time.",
  "tags": [
    "homelab",
    "logs",
    "loki",
    "journald"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "loki",
        "label": "Loki",
        "query": "loki",
        "hide": 2,
        "refresh": 1,
        "regex": "",
        "current": {
          "text": "homelab-loki",
          "value": "homelab-loki"
        },
        "options": []
      },
      {
        "type": "constant",
        "name": "noise",
        "query": "systemd-.*|alloy[.]service|generate-shutdown-ramfs[.]service|firewall[.]service|dbus[.]service|dbus-broker[.]service|nix-daemon[.]service|logrotate[.]service",
        "hide": 2,
        "current": {
          "text": "systemd-.*|alloy[.]service|generate-shutdown-ramfs[.]service|firewall[.]service|dbus[.]service|dbus-broker[.]service|nix-daemon[.]service|logrotate[.]service",
          "value": "systemd-.*|alloy[.]service|generate-shutdown-ramfs[.]service|firewall[.]service|dbus[.]service|dbus-broker[.]service|nix-daemon[.]service|logrotate[.]service"
        },
        "options": []
      },
      {
        "type": "query",
        "name": "host",
        "label": "Host",
        "description": "Host the logs come from.",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": {
          "label": "host",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(host)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "allowCustomValue": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "query",
        "name": "container",
        "label": "Container",
        "description": "Host or service container.",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": {
          "label": "container",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{host=~\"$host\"}",
          "type": 1
        },
        "definition": "label_values({host=~\"$host\"}, container)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "allowCustomValue": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "query",
        "name": "unit",
        "label": "Unit",
        "description": "Systemd unit inside the selected containers.",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": {
          "label": "unit",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{host=~\"$host\", container=~\"$container\"}",
          "type": 1
        },
        "definition": "label_values({host=~\"$host\", container=~\"$container\"}, unit)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "allowCustomValue": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "query",
        "name": "priority",
        "label": "Priority",
        "description": "Journald priority.",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": {
          "label": "priority",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(priority)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "allowCustomValue": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Search regex",
        "description": "Regex applied to the raw log line before parsing.",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      },
      {
        "type": "custom",
        "name": "parser",
        "label": "Parser",
        "description": "Query-time parser for log lines. None is cheapest and still exposes structured metadata that Alloy attached at ingest (Caddy fields). JSON and logfmt parse every line; lines that do not match are kept unparsed.",
        "query": "None : __error__=\"\",JSON : json | drop __error__\\, __error_details__,logfmt : logfmt | drop __error__\\, __error_details__",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "None",
          "value": "__error__=\"\""
        },
        "options": [
          {
            "text": "None",
            "value": "__error__=\"\"",
            "selected": true
          },
          {
            "text": "JSON",
            "value": "json | drop __error__, __error_details__",
            "selected": false
          },
          {
            "text": "logfmt",
            "value": "logfmt | drop __error__, __error_details__",
            "selected": false
          }
        ]
      },
      {
        "type": "adhoc",
        "name": "filters",
        "label": "Field filters",
        "description": "Filters on stream labels or parsed JSON fields, e.g. status = 502 or request_host = git.ishanjain.me. Applied to every panel.",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "filters": [],
        "baseFilters": [],
        "allowCustomValue": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Log lines",
      "description": "Application log lines in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({source=\"journald\", host=~\"$host\", container=~\"$container\", unit=~\"$unit\", unit=~\".+[.]service\", unit!~\"$noise\", priority=~\"$priority\"} |~ \"$search\" | $parser [$__range]))",
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Warnings",
      "description": "Lines at warning priority in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({source=\"journald\", host=~\"$host\", container=~\"$container\", unit=~\"$unit\", unit=~\".+[.]service\", unit!~\"$noise\", priority=~\"$priority\", priority=\"warning\"} |~ \"$search\" | $parser [$__range]))",
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors",
      "description": "Lines at err, crit, alert or emerg priority in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
