          "expr": "count(sum by (host, container, unit) (count_over_time({source=\"journald\", host=~\"$host\", container=~\"$container\", unit=~\"$unit\", unit=~\".+[.]service\", unit!~\"$noise\", priority=~\"$priority\"} |~ \"$search\" | $parser [$__range])))",
          "refId": "A",
          "editorMode": "code",
