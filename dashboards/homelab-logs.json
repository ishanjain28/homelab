{
  "uid": "homelab-logs",
  "title": "Homelab Logs",
  "description": "Journald logs from hosts and nspawn service containers, collected by Alloy and stored in VictoriaLogs. JSON log lines are split into fields, so any field can be used in Filters.",
  "tags": [
    "homelab",
    "logs",
    "victorialogs",
    "journald"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "noise",
        "query": "systemd-.*|alloy[.]service|generate-shutdown-ramfs[.]service|firewall[.]service|dbus[.]service|dbus-broker[.]service|nix-daemon[.]service|logrotate[.]service",
        "hide": 2,
        "current": {
          "text": "systemd-.*|alloy[.]service|generate-shutdown-ramfs[.]service|firewall[.]service|dbus[.]service|dbus-broker[.]service|nix-daemon[.]service|logrotate[.]service",
          "value": "systemd-.*|alloy[.]service|generate-shutdown-ramfs[.]service|firewall[.]service|dbus[.]service|dbus-broker[.]service|nix-daemon[.]service|logrotate[.]service"
        },
        "options": []
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "host",
          "query": "{source=\"journald\"}",
          "refId": "host"
        },
        "definition": "host",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "container",
          "query": "{source=\"journald\", host=~\"$host\"}",
          "refId": "container"
        },
        "definition": "container",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "unit",
        "label": "Unit",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "unit",
          "query": "{source=\"journald\", host=~\"$host\", container=~\"$container\"}",
          "refId": "unit"
        },
        "definition": "unit",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "priority",
        "label": "Priority",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "priority",
          "query": "{source=\"journald\"}",
          "refId": "priority"
        },
        "definition": "priority",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Search regex",
        "description": "Regex applied to the raw log line before parsing.",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      },
      {
        "name": "filters",
        "label": "Filters",
        "type": "adhoc",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
