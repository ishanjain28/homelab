  "elements": {
    "panel-1": {
      "kind": "Panel",
      "spec": {
        "id": 1,
        "title": "App Log Lines / 15m",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "query": {
                    "kind": "DataQuery",
                    "group": "loki",
                    "version": "v0",
                    "datasource": {
                      "name": "homelab-loki"
                    },
                    "spec": {
                      "editorMode": "code",
                      "expr": "sum(count_over_time({source=\"journald\", container=~\"$container\", unit=~\"$unit\", unit=~\".+[.]service\", unit!~\"systemd-.*|alloy[.]service|generate-shutdown-ramfs[.]service|firewall[.]service|dbus[.]service|dbus-broker[.]service|nix-daemon[.]service|systemd-journald[.]service|systemd-tmpfiles-.*[.]service|systemd-networkd[.]service|systemd-resolved[.]service|systemd-sysctl[.]service|systemd-remount-fs[.]service|systemd-random-seed[.]service|systemd-modules-load[.]service|systemd-machine-id-commit[.]service|systemd-update-done[.]service|systemd-vconsole-setup[.]service|logrotate[.]service\", priority=~\"$priority\"}[15m]))",
                      "queryType": "range"
                    }
                  },
                  "refId": "A",
                  "hidden": false
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "stat",
          "version": "11.0.0",
          "spec": {
            "options": {
              "colorMode": "value",
              "graphMode": "area",
              "justifyMode": "auto",
              "orientation": "auto",
              "reduceOptions": {
                "calcs": [
                  "lastNotNull"
                ],
                "fields": "",
                "values": false
              },
              "textMode": "auto",
              "wideLayout": true
            },
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "thresholds"
                },
                "mappings": [],
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": 0
                    }
                  ]
                },
                "unit": "short"
              },
              "overrides": []
            }
          }
        },
        "description": "Count of application service log lines in the last 15 minutes."
      }
    },
