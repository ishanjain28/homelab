{
  "title": "Homelab Logs",
  "description": "Homelab journald logs collected by Alloy and stored in Loki.",
  "tags": [
    "homelab",
    "logs",
    "loki",
    "journald"
  ],
  "cursorSync": "Off",
  "editable": true,
  "links": [],
  "liveNow": false,
  "preload": false,
  "timeSettings": {
    "timezone": "browser",
    "from": "now-6h",
    "to": "now",
    "autoRefresh": "30s",
    "autoRefreshIntervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ],
    "hideTimepicker": false,
    "fiscalYearStartMonth": 0
  },
  "variables": [
    {
      "kind": "QueryVariable",
      "spec": {
        "name": "container",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "label": "Container",
        "hide": "dontHide",
        "skipUrlSync": false,
        "refresh": "onDashboardLoad",
        "query": {
          "kind": "DataQuery",
          "group": "loki",
          "version": "v0",
          "datasource": {
            "name": "homelab-loki"
          },
          "spec": {
            "query": "label_values({source=\"journald\"}, container)"
          }
        },
        "regex": "",
        "sort": "alphabeticalAsc",
        "definition": "label_values({source=\"journald\"}, container)",
        "options": [],
        "multi": true,
        "includeAll": true,
        "allowCustomValue": true,
        "description": "Filter logs by host or service container.",
        "allValue": ".*"
      }
    },
    {
      "kind": "QueryVariable",
      "spec": {
        "name": "unit",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
