          "datasource": {
            "name": "homelab-loki"
          },
          "spec": {
            "query": "label_values({source=\"journald\"}, unit)"
          }
        },
        "regex": "",
        "sort": "alphabeticalAsc",
        "definition": "label_values({source=\"journald\"}, unit)",
        "options": [],
        "multi": true,
        "includeAll": true,
        "allowCustomValue": true,
        "description": "Filter logs by systemd unit.",
        "allValue": ".*"
      }
    },
    {
      "kind": "QueryVariable",
      "spec": {
        "name": "priority",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "label": "Priority",
        "hide": "dontHide",
        "skipUrlSync": false,
        "refresh": "onDashboardLoad",
        "query": {
          "kind": "DataQuery",
          "group": "loki",
          "version": "v0",
          "datasource": {
            "name": "homelab-loki"
          },
          "spec": {
            "query": "label_values({source=\"journald\"}, priority)"
          }
        },
        "regex": "",
        "sort": "alphabeticalAsc",
        "definition": "label_values({source=\"journald\"}, priority)",
        "options": [],
        "multi": true,
        "includeAll": true,
        "allowCustomValue": true,
        "description": "Filter logs by journald priority.",
        "allValue": ".*"
