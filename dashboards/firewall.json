{
  "title": "Firewall",
  "uid": "firewall",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "homelab",
    "firewall"
  ],
  "timezone": "browser",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "host",
          "query": "{container=\"host\", transport=\"kernel\"} ~\"^firewall [a-z0-9-]+/\"",
          "refId": "host"
        },
        "definition": "host",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Traffic the container firewall does not allow. In **log** mode it is only logged and still gets through; in **drop** mode it is blocked.\n\n**Inbound:** a connection to a service endpoint from a caller not in its `from` list. **Internet:** a new connection to the internet from a service with `networking.internet = false`."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Inbound attempts",
      "description": "Connections to endpoints from callers not in their from list.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "{container=\"host\", transport=\"kernel\", host=~\"$host\"} ~\"^firewall [a-z0-9-]+/\" | extract_regexp `^firewall (?P<service>[a-z0-9-]+)/(?P<rule>[a-z0-9-]+): IN=(?P<in_if>\\S*) OUT=(?P<out_if>\\S*) (?:MAC=\\S+ )?SRC=(?P<src>\\S+) DST=(?P<dst>\\S+) .*?PROTO=(?P<proto>[A-Za-z0-9-]+)(?: SPT=(?P<sport>\\d+) DPT=(?P<dport>\\d+))?` | filter rule:!=internet | stats count() as attempts",
          "queryType": "stats"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "id": 2
    },
