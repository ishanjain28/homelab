          "refId": "A",
          "expr": "{source=\"syslog\", container=~\"$device\", priority=~\"$priority\"} ~\"$search\" | stats count_uniq(container) as devices",
          "queryType": "stats"
        }
      ],
      "options": {
        "colorMode": "value",
