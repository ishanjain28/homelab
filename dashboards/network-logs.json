    {
      "type": "logs",
      "title": "Firewall log",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{source=\"syslog\", container=~\"$device\", priority=~\"$priority\"} |~ \"$search\" |~ \"^firewall,\"",
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "",
          "maxLines": 1000
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "sortOrder": "Descending",
        "enableInfiniteScrolling": true
      }
    },
    {
      "type": "row",
      "title": "DHCP",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": [
        {
          "type": "table",
          "title": "DHCP leases",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "gridPos": {
            "h": 10,
            "w": 24,
            "x": 0,
            "y": 42
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "${loki}"
              },
              "expr": "sum by (server, ip, mac, client) (count_over_time({source=\"syslog\", container=~\"$device\", priority=~\"$priority\"} |~ \"$search\" |~ \"^dhcp,\" | regexp `^dhcp,[a-z,]+ (?P<server>\\S+) (?P<event>assigned|deassigned) (?P<ip>\\S+) (?:for|to|from) (?P<mac>\\S+)(?: (?P<client>.+))?` | event=\"assigned\" | server!=\"\" [$__range]))",
              "refId": "A",
              "editorMode": "code",
              "queryType": "instant",
              "legendFormat": ""
            }
          ],
          "transformations": [
            {
              "id": "reduce",
              "options": {
                "mode": "seriesToRows",
                "reducers": [
                  "lastNotNull"
                ],
                "labelsToFields": true
              }
            },
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Field": true
                },
                "indexByName": {
                  "client": 0,
                  "ip": 1,
                  "mac": 2,
                  "server": 3,
                  "Count": 4
                },
                "renameByName": {
                  "Last *": "Leases",
                  "Last": "Leases",
                  "client": "Client",
                  "ip": "IP",
                  "mac": "MAC",
                  "server": "VLAN"
                }
              }
            },
            {
              "id": "sortBy",
              "options": {
                "sort": [
                  {
                    "field": "Leases",
                    "desc": true
                  }
                ]
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "align": "auto",
                "filterable": true
              }
            },
            "overrides": []
          },
          "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "footer": {
              "show": false
            }
          }
        }
      ]
    },
