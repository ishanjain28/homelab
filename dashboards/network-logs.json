              "refId": "A",
              "expr": "{source=\"syslog\", container=~\"$device\", priority=~\"$priority\"} ~\"$search\" ~\"^dhcp,\" | extract_regexp `^dhcp,[a-z,]+ (?P<server>\\S+) (?P<event>assigned|deassigned) (?P<ip>\\S+) (?:for|to|from) (?P<mac>\\S+)(?: (?P<client>.+))?` | filter event:=\"assigned\" server:!=\"\" | stats by (server, ip, mac, client) count() as leases",
              "queryType": "stats"
            }
          ],
          "transformations": [
