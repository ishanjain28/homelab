          "expr": "sum by (in, out) (count_over_time({source=\"syslog\", container=~\"$device\", priority=~\"$priority\"} |~ \"$search\" |~ \"^firewall,\" | regexp `^firewall,[a-z,]+ (?:(?P<prefix>.*) )?(?P<chain>[a-z0-9-]+): in:(?P<in>\\S+) out:(?P<out>[^,]+), (?:connection-state:\\S+ )?(?:src-mac \\S+, )?proto (?P<proto>[A-Za-z0-9-]+)(?: \\([^)]*\\))?, (?P<src>\\[[0-9a-fA-F:]+\\]|[0-9.]+|[0-9a-fA-F:]+)(?::(?P<sport>\\d+))?->(?P<dst>\\[[0-9a-fA-F:]+\\]|[0-9.]+|[0-9a-fA-F:]+)(?::(?P<dport>\\d+))?, len (?P<len>\\d+)` | prefix=~\"(?i).*drop.*\" [$__auto]))",
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{in}} \u2192 {{out}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
