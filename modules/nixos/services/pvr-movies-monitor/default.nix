{
  config,
  lib,
  namespace,
  pkgs,
  ...
}:
with lib;
with lib.${namespace};
let
  srv = config.${namespace}.services;
  cfg = srv.pvr-movies-monitor;
in
{
  options.${namespace}.services.pvr-movies-monitor = with types; {
    enable = mkEnableOption "PVR Movies Monitor";
    host = mkOpt str "" "Listen address for this application";
    port = mkOpt port "" "Port to listen on";
    apiKey = mkOpt str "" "API Key for the application";
    volumeConfig = lib.mkOption {
      type = attrsOf attrs;
      default = { };
      description = "Volume configurations generated by mkContainerVolume";
    };
  };

  config = mkIf cfg.enable (mkMerge [
    {
      containers.pvr-movies-monitor = {
        autoStart = true;
        privateNetwork = true;
        macvlans = [ "hvlan50" ];

        specialArgs = {
          inherit namespace;
          pvr-movies-monitor-package = pkgs.${namespace}.pvr-movies-monitor;
        };

        config =
          { pvr-movies-monitor-package, ... }:
          {
            networking = {
              networkmanager = disabled;
              firewall = enabled // {
                allowedTCPPorts = [ cfg.port ];
              };
            };

            environment.systemPackages = with pkgs; [ kitty.terminfo ];

            systemd.services.pvr-movies-monitor = {
              description = "PVR Movies Monitoring Service";
              wantedBy = [ "multi-user.target" ];
              environment = {
                API_KEY = cfg.apiKey;
                HOST = cfg.host;
                PORT = builtins.toString cfg.port;
                RUST_LOG = "info";
              };
              serviceConfig = {
                ExecStart = "${pvr-movies-monitor-package}/bin/pvr-movies-monitor";
                Restart = "always";
                DynamicUser = true;
              };
            };

            system.stateVersion = "26.05";
          };
      };
    }
  ]);
}
